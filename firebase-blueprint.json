{
  "entities": {
    "PrivateProfile": {
      "title": "PrivateProfile",
      "description": "Private user delivery & account contact info isolated under users/{userId}/private/{docId}",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "phone": { "type": "string", "minLength": 0, "maxLength": 32 },
        "savedAddress": { "type": "string", "minLength": 0, "maxLength": 300 },
        "preferredLang": { "type": "string", "enum": ["ar", "en"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "preferredLang", "createdAt", "updatedAt"]
    },
    "WishlistItem": {
      "title": "WishlistItem",
      "description": "Saved garment item inside a user's wishlist subcollection",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "titleAr": { "type": "string", "minLength": 1, "maxLength": 140 },
        "titleEn": { "type": "string", "minLength": 1, "maxLength": 140 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "productId", "titleAr", "titleEn", "createdAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "AI Atelier chat session metadata stored per user",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "model": { "type": "string", "enum": ["gemini-4-hydrogen", "gemini-3.1-flash-lite", "gemini-4-carbon", "gemini-4-neon"] },
        "useSearchGrounding": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "title", "model", "useSearchGrounding", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual turn inside a user's AI Atelier chat session",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["user", "model"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "model": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sources": { "type": "array", "description": "Bounded list (max 8) of grounded source strings" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "role", "text", "model", "sources", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/PrivateProfile" },
      "description": "Owner-only private profile & saved checkout contact preferences"
    },
    "/users/{userId}/wishlist/{productId}": {
      "schema": { "$ref": "#/entities/WishlistItem" },
      "description": "Owner-only saved MARAYA garments"
    },
    "/users/{userId}/chatSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "Owner-only AI Atelier conversation threads"
    },
    "/users/{userId}/chatSessions/{sessionId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Owner-only messages within an AI Atelier conversation thread"
    }
  }
}
