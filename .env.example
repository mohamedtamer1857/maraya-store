# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Provisioned Google Maps Platform API key.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Staff Portal Administrator Credentials (Recommended for Vercel deployments).
# Set these in Vercel Environment Variables so admin login works permanently across cold starts.
# Leave unset to configure the admin username and password via the first-run setup UI on /staff.
STAFF_ADMIN_USERNAME=
STAFF_ADMIN_PASSWORD=
STAFF_SESSION_SECRET=
