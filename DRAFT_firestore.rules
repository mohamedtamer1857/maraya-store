rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1 / Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive helpers
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPrivateProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'preferredLang', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'phone', 'savedAddress', 'preferredLang', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32))
        && (!('savedAddress' in data) || (data.savedAddress is string && data.savedAddress.size() <= 300))
        && data.preferredLang in ['ar', 'en']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWishlistItem(data, productId) {
      return data.keys().hasAll(['uid', 'productId', 'titleAr', 'titleEn', 'createdAt'])
        && data.keys().hasOnly(['uid', 'productId', 'titleAr', 'titleEn', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.productId is string && data.productId == productId && isValidId(data.productId)
        && data.titleAr is string && data.titleAr.size() >= 1 && data.titleAr.size() <= 140
        && data.titleEn is string && data.titleEn.size() >= 1 && data.titleEn.size() <= 140
        && data.createdAt is timestamp;
    }

    function isValidChatSession(data) {
      return data.keys().hasAll(['uid', 'title', 'model', 'useSearchGrounding', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'title', 'model', 'useSearchGrounding', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.model in ['gemini-4-hydrogen', 'gemini-3.1-flash-lite', 'gemini-4-carbon', 'gemini-4-neon']
        && data.useSearchGrounding is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['uid', 'role', 'text', 'model', 'sources', 'createdAt'])
        && data.keys().hasOnly(['uid', 'role', 'text', 'model', 'sources', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.role in ['user', 'model']
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 12000
        && data.model is string && data.model.size() >= 1 && data.model.size() <= 64
        && data.sources is list && data.sources.size() <= 8
        && (data.sources.size() == 0 || (data.sources[0] is string && data.sources[0].size() <= 600))
        && data.createdAt is timestamp;
    }

    // Owner-isolated PII collection
    match /users/{userId}/private/{docId} {
      allow get: if isValidId(userId) && isValidId(docId) && isOwner(userId);
      allow list: if isValidId(userId) && isOwner(userId) && existing().uid == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && docId == 'info'
        && isOwner(userId)
        && isValidPrivateProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && docId == 'info'
        && isOwner(userId)
        && isValidPrivateProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'phone', 'savedAddress', 'preferredLang', 'updatedAt']);
      allow delete: if false;
    }

    // Owner-isolated wishlist collection
    match /users/{userId}/wishlist/{productId} {
      allow get: if isValidId(userId) && isValidId(productId) && isOwner(userId);
      allow list: if isValidId(userId) && isOwner(userId) && existing().uid == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidId(productId)
        && isOwner(userId)
        && isValidWishlistItem(incoming(), productId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(productId) && isOwner(userId);
    }

    // Owner-isolated AI Atelier chat sessions & message subcollection
    match /users/{userId}/chatSessions/{sessionId} {
      allow get: if isValidId(userId) && isValidId(sessionId) && isOwner(userId);
      allow list: if isValidId(userId) && isOwner(userId) && existing().uid == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidId(sessionId)
        && isOwner(userId)
        && isValidChatSession(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidId(sessionId)
        && isOwner(userId)
        && isValidChatSession(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'model', 'useSearchGrounding', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(sessionId) && isOwner(userId);

      match /messages/{messageId} {
        allow get: if isValidId(userId) && isValidId(sessionId) && isValidId(messageId) && isOwner(userId);
        allow list: if isValidId(userId) && isValidId(sessionId) && isOwner(userId) && existing().uid == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(sessionId)
          && isValidId(messageId)
          && isOwner(userId)
          && isValidChatMessage(incoming())
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId)/chatSessions/$(sessionId));
        allow update: if false;
        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(sessionId) && isValidId(messageId) && isOwner(userId);
      }
    }
  }
}
